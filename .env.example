# Server
PORT=3000

# Recipient phone number, E.164 format with country code
RECIPIENT_PHONE=+233201234567

# Cron schedule (every 5 minutes by default)
CRON_SCHEDULE=*/5 * * * *
# Optional IANA timezone for the cron job
CRON_TIMEZONE=Africa/Accra

# AgooSMS (get your key at https://developer.agoosms.com)
AGOOSMS_API_KEY=agoo_live_xxx
# Optional: an approved sender ID. Leave blank to use AgooSMS's default.
AGOOSMS_SENDER_ID=
# Optional override; defaults to https://api.agoosms.com/v1/sms/send
AGOOSMS_API_URL=

# Set to true to log messages instead of actually sending (handy for testing)
DRY_RUN=false
