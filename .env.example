# Server
PORT=3000

# Recipient phone number (international format, e.g. 233XXXXXXXXX)
RECIPIENT_PHONE=233XXXXXXXXX

# Cron schedule — every 5 minutes by default
CRON_SCHEDULE=*/5 * * * *
# Optional IANA timezone for the cron job
CRON_TIMEZONE=Africa/Accra

# AgooSMS credentials / endpoint — copy these from your AgooSMS dashboard / API docs
AGOOSMS_API_URL=https://api.agoosms.com/v1/sms/send
AGOOSMS_API_KEY=your_api_key_here
AGOOSMS_SENDER_ID=MyBrand

# Set to true to log messages instead of actually sending (handy for testing)
DRY_RUN=false
